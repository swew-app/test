{
    "name": "swew/test",
    "description": "A test framework that is designed to fix the fatal flaw of other test frameworks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "TDD",
        "testing",
        "fast",
        "lightweight",
        "informative interface"
    ],
    "authors": [
        {
            "name": "AVIL13",
            "email": "avil@swew.app"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "bin": [
        "bin/t",
        "bin/pest"
    ],
    "autoload": {
        "psr-4": {
            "Swew\\Test\\": "src/"
        },
        "files": [
            "src/Functions.php"
        ],
        "exclude-from-classmap": [
            "spec",
            "/Tests/",
            "/test/",
            "/tests/"
        ]
    },
    "archive": {
        "exclude": [
            "tests",
            "swew.json"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../dd",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../swew-cli",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "swew/cli": "*",
        "swew/dd": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "carthage-software/mago": "1.59.0"
    },
    "scripts": {
        "test": "@php bin/t --dir=tests --config=tests/config.json",
        "static": "mago analyze --minimum-report-level warning",
        "lint": "mago lint --minimum-report-level warning",
        "code-check": "mago format --check",
        "format": "mago format",
        "check": [
            "@static",
            "@lint",
            "@code-check"
        ]
    }
}
