#!/usr/bin/env php
<?php declare(strict_types=1);

use Swew\Test\TestMaster;

(static function () {
    // Used when SWEW-test is required using composer.
    $vendorPath = dirname(__DIR__, 4).'/vendor/autoload.php';

    // Used when SWEW-test maintainers are running SWEW-test tests.
    $localPath = dirname(__DIR__).'/vendor/autoload.php';

    $autoloadPath = $GLOBALS['_composer_autoload_path'] ?? null;
    if (!is_string($autoloadPath)) {
        $autoloadPath = file_exists($vendorPath) ? $vendorPath : $localPath;
    }
    require_once $autoloadPath;

    TestMaster::runTest();

})();
